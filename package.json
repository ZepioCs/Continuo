{
  "name": "continuo-mcp",
  "version": "1.0.0",
  "description": "Advanced MCP memory & context server with token-aware selection, session tracking, and priority-based context management",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "test": "bun test",
    "lint": "bunx biome check src/",
    "lint:fix": "bunx biome check --apply src/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.16",
    "typescript": "^5.7.3",
    "bun-types": "^1.2.2",
    "@biomejs/biome": "^1.9.4"
  }
}
